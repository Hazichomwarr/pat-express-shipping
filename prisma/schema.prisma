// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Geography-neutral shipment lifecycle. What happened, not where. Combine with
// ShipmentDirection to derive geography (e.g. US_TO_BF + PACKAGE_RECEIVED means
// received at the U.S. origin; BF_TO_US + PACKAGE_RECEIVED means received at the
// Burkina Faso origin).
enum ShipmentStatus {
  AWAITING_PACKAGE
  PACKAGE_RECEIVED
  AWAITING_QUOTE
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  IN_TRANSIT
  ARRIVED_DESTINATION
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
}

// US_TO_BF: origin United States, destination Burkina Faso.
// BF_TO_US: origin Burkina Faso, destination United States.
// Direction is the authoritative route classification; ShipmentStatus never
// encodes geography itself.
enum ShipmentDirection {
  US_TO_BF
  BF_TO_US
}

enum ShipmentIntakeMethod {
  DROP_OFF
  MAIL_IN
}

enum ShipmentItemCategory {
  GENERAL
  CLOTHING
  ELECTRONICS
  DOCUMENTS
  FOOD
  HOUSEHOLD
  COMMERCIAL_GOODS
  OTHER
}

enum ShipmentQuoteCurrency {
  USD
}

enum ShipmentPaymentMethod {
  ZELLE
  CASH
  ORANGE_MONEY
}

enum ShipmentPaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum StaffRole {
  ADMIN
  STAFF
}

model Shipment {
  id             String               @id @default(cuid())
  trackingNumber String               @unique
  status         ShipmentStatus       @default(AWAITING_PACKAGE)
  direction      ShipmentDirection
  intakeMethod   ShipmentIntakeMethod

  senderName  String
  senderPhone String
  senderEmail String?

  recipientName  String
  recipientPhone String
  recipientEmail String?
  recipientCity  String
  recipientNotes String?

  customerNotes String?
  internalNotes String?

  // Quote fields are all null before quotation and all populated after quotation.
  measuredWeightKg Decimal?               @db.Decimal(10, 3)
  ratePerKg        Decimal?               @db.Decimal(12, 2)
  quotedAmount     Decimal?               @db.Decimal(12, 2)
  quoteCurrency    ShipmentQuoteCurrency?
  quotedAt         DateTime?

  packageReceivedAt    DateTime?
  paymentConfirmedAt   DateTime?
  arrivedDestinationAt DateTime?
  readyForPickupAt     DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?

  items    ShipmentItem[]
  payments ShipmentPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([senderPhone])
  @@index([senderEmail])
  @@index([recipientPhone])
  @@index([createdAt])
}

model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  description   String
  category      ShipmentItemCategory
  quantity      Int                  @default(1)
  declaredValue Decimal?             @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(STAFF)
  isActive     Boolean   @default(true)

  confirmedPayments ShipmentPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShipmentPayment {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  method   ShipmentPaymentMethod
  status   ShipmentPaymentStatus @default(PENDING)
  amount   Decimal               @db.Decimal(12, 2)
  currency ShipmentQuoteCurrency

  // Payment identity invariants are enforced by validation/service logic:
  // ZELLE uses only zelleName; ORANGE_MONEY uses only mobileMoneyPayerName;
  // CASH keeps both fields null.
  zelleName            String?
  mobileMoneyPayerName String?

  // PENDING has no lifecycle timestamps or confirmer. CONFIRMED has confirmedAt and a
  // confirming staff identity. CANCELLED has cancelledAt and no confirmation metadata.
  confirmedAt        DateTime?
  confirmedByStaffId String?
  confirmedBy        StaffUser? @relation(fields: [confirmedByStaffId], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([status])
  @@index([confirmedByStaffId])
}
